# JARVIS Environment Configuration Example
# Copy this file to .env and customize your settings.

# ==============================================================================
# Gemini LLM Provider (Google AI Studio)
# ==============================================================================
# Required for full conversational AI responses.
# If omitted, JARVIS will operate using the built-in local rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# ==============================================================================
# Voice & Text-to-Speech (TTS) Configuration
# ==============================================================================
# Optional: ElevenLabs API Key for profile voices (JARVIS / FRIDAY).
# If not configured, voice falls back to Kokoro TTS, then system speech (macOS 'say').
ELEVENLABS_API_KEY=

# Primary TTS engine: kokoro, edge, or sapi
JARVIS_TTS=kokoro
JARVIS_KOKORO_VOICE=af_heart
JARVIS_KOKORO_LANGUAGE=a
JARVIS_RATE=0
JARVIS_VOLUME=100

# Edge TTS voices (optional)
JARVIS_EDGE_VOICE=en-US-JennyNeural
JARVIS_EDGE_RATE=+0%
JARVIS_EDGE_VOLUME=+0%

# ==============================================================================
# UI and Network Configuration
# ==============================================================================
JARVIS_UI_PORT=8765

# ==============================================================================
# Audio & Microphone Settings
# ==============================================================================
# Leave empty to use system default microphone.
# JARVIS_MIC_DEVICE=
JARVIS_SILENCE_THRESHOLD=0.002
JARVIS_MIC_WARMUP=0.2
